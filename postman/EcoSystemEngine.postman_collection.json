                  "    pm.expect(responseJson.message).to.eql(\"services retrieved successfully\");",
                  "    ",
                  "    pm.expect(responseJson.data).to.be.an(\"array\");",
                  "});",
                  "",
                  "pm.test(\"All items in 'data' array match the expected schema and data types\", function () {",
                  "    const dataArray = responseJson.data;",
                  "    const uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;",
                  "",
                  "    if (dataArray.length > 0) {",
                  "        dataArray.forEach((item, index) => {",
                  "            pm.expect(item, `Missing 'id' at index ${index}`).to.have.property(\"id\");",
                  "            pm.expect(item, `Missing 'name' at index ${index}`).to.have.property(\"name\");",
                  "            pm.expect(item, `Missing 'description' at index ${index}`).to.have.property(\"description\");",
                  "            pm.expect(item, `Missing 'price' at index ${index}`).to.have.property(\"price\");",
                  "            pm.expect(item, `Missing 'created_at' at index ${index}`).to.have.property(\"created_at\");",
                  "            pm.expect(item, `Missing 'updated_at' at index ${index}`).to.have.property(\"updated_at\");",
                  "",
                  "            pm.expect(item.id).to.be.a(\"string\");",
                  "            pm.expect(item.name).to.be.a(\"string\");",
                  "            pm.expect(item.description).to.be.a(\"string\");",
                  "            pm.expect(item.price).to.be.a(\"number\");",
                  "            pm.expect(item.created_at).to.be.a(\"string\");",
                  "            pm.expect(item.updated_at).to.be.a(\"string\");",
                  "",
                  "            pm.expect(item.id, `Invalid UUID format at index ${index}`).to.match(uuidRegex);",
                  "        });",
                  "    }",
                  "});"
