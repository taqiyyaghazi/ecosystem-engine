                  "let requestHeaders = {",
                  "    'Content-Type': 'application/json'",
                  "};",
                  "const authHeader = pm.request.headers.get('Authorization');",
                  "if (authHeader) {",
                  "    requestHeaders['Authorization'] = authHeader;",
                  "}",
                  "",
                  "const negativeScenarios = [",
                  "    {",
                  "        name: \"Case 1: Invalid ID Format (Bukan UUID)\",",
                  "        testId: \"bukan-format-uuid-123\",",
                  "        expectedStatus: 400,",
                  "        expectedError: \"invalid ID format\"",
                  "    },",
                  "    {",
                  "        name: \"Case 2: ID UUID Valid tapi tidak ditemukan (Not Found)\",",
                  "        testId: \"00000000-0000-0000-0000-000000000000\",",
                  "        expectedStatus: 404,",
                  "        expectedError: \"resource not found\"",
                  "    }",
                  "];",
                  "",
                  "negativeScenarios.forEach(scenario => {",
                  "    const req = {",
                  "        url: `${baseUrl}/${scenario.testId}`,",
                  "        method: 'GET',",
                  "        header: requestHeaders",
                  "    };",
                  "",
                  "    pm.sendRequest(req, function (err, res) {",
                  "        pm.test(`${scenario.name}`, function () {",
                  "            if (err) throw err;",
                  "",
                  "            pm.expect(res.code, `HTTP Status harus ${scenario.expectedStatus}`).to.eql(scenario.expectedStatus);",
                  "",
                  "            const responseJson = res.json();",
                  "            pm.expect(responseJson, \"Response harus memiliki properti 'error'\").to.have.property('error');",
                  "            pm.expect(responseJson.error, \"Pesan error tidak sesuai ekspektasi\").to.eql(scenario.expectedError);",
                  "        });",
                  "    });",
                  "});",
                  ""
                ],
