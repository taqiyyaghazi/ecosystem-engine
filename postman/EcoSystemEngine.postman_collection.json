            },
            "description": "Generated from cURL: curl --request POST --url 'http://{{host}}:{{port}}/v1/services' --header 'Content-Type: application/json' --data '{\"description\":\"Invalid payload without required name\",\"price\":\"10000\"}'"
          },
          "response": []
        },
        {
          "name": "Create Service with Valid Payload",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const responseJson = pm.response.json();",
                  "",
                  "pm.test(\"HTTP Status is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response contains 'data' and expected 'message'\", function () {",
                  "    pm.expect(responseJson).to.have.property(\"data\");",
                  "    pm.expect(responseJson).to.have.property(\"message\");",
                  "    pm.expect(responseJson.message).to.eql(\"service created successfully\");",
                  "});",
                  "",
                  "pm.test(\"Data object contains valid properties and data types\", function () {",
                  "    const data = responseJson.data;",
                  "",
                  "    pm.expect(data).to.have.property(\"id\");",
                  "    pm.expect(data).to.have.property(\"name\");",
                  "    pm.expect(data).to.have.property(\"description\");",
                  "    pm.expect(data).to.have.property(\"price\");",
                  "    pm.expect(data).to.have.property(\"created_at\");",
                  "    pm.expect(data).to.have.property(\"updated_at\");",
                  "",
                  "    pm.expect(data.id).to.be.a(\"string\");",
                  "    pm.expect(data.name).to.be.a(\"string\");",
                  "    pm.expect(data.description).to.be.a(\"string\");",
                  "    pm.expect(data.price).to.be.a(\"number\");",
                  "    pm.expect(data.created_at).to.be.a(\"string\");",
                  "    pm.expect(data.updated_at).to.be.a(\"string\");",
                  "",
                  "    const uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;",
                  "    pm.expect(data.id, \"Format ID harus berupa UUID\").to.match(uuidRegex);",
                  "});",
                  "",
                  "pm.test(\"Returned data matches the sent request payload\", function () {",
                  "    const requestPayload = JSON.parse(pm.request.body.raw);",
                  "    const data = responseJson.data;",
                  "",
                  "    pm.expect(data.name).to.eql(requestPayload.name);",
                  "    pm.expect(data.price).to.eql(requestPayload.price);",
                  "    ",
                  "    if (requestPayload.description !== undefined) {",
                  "        pm.expect(data.description).to.eql(requestPayload.description);",
                  "    }",
                  "});",
                  "",
                  "pm.test(\"Save Service ID to Environment\", function () {",
                  "    const serviceId = responseJson.data.id;",
                  "    ",
                  "    pm.expect(serviceId).to.not.be.undefined;",
                  "    ",
                  "    pm.environment.set(\"serviceId\", serviceId);",
                  "    ",
                  "    console.log(\"ID berhasil disimpan ke environment: \", serviceId);",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
