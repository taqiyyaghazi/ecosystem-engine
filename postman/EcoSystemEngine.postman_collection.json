        {
          "name": "Create Service with Invalid Payload",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const negativeScenarios = [",
                  "    {",
                  "        name: \"Missing 'name' field\",",
                  "        payload: { description: \"Service tanpa nama\", price: 50000.0 }",
                  "    },",
                  "    {",
                  "        name: \"Empty 'name' (Zero-value string)\",",
                  "        payload: { name: \"\", description: \"Nama kosong string\", price: 50000.0 }",
                  "    },",
                  "    {",
                  "        name: \"Missing 'price' field\",",
                  "        payload: { name: \"Service A\", description: \"Tanpa harga\" }",
                  "    },",
                  "    {",
                  "        name: \"Zero 'price' (Zero-value float64)\", ",
                  "        payload: { name: \"Service A\", description: \"Harga nol\", price: 0 }",
                  "    },",
                  "    {",
                  "        name: \"Invalid 'price' data type\",",
                  "        payload: { name: \"Service A\", description: \"Harga string\", price: \"50000.0\" }",
                  "    },",
                  "    {",
                  "        name: \"Empty JSON body\",",
                  "        payload: {}",
                  "    }",
                  "];",
                  "",
                  "const requestUrl = pm.request.url.toString();",
                  "const requestMethod = pm.request.method;",
                  "",
                  "let requestHeaders = {",
                  "    'Content-Type': 'application/json'",
                  "};",
                  "const authHeader = pm.request.headers.get('Authorization');",
                  "if (authHeader) {",
                  "    requestHeaders['Authorization'] = authHeader;",
                  "}",
                  "",
                  "negativeScenarios.forEach(scenario => {",
                  "    const req = {",
                  "        url: requestUrl,",
                  "        method: requestMethod,",
                  "        header: requestHeaders,",
                  "        body: {",
                  "            mode: 'raw',",
                  "            raw: JSON.stringify(scenario.payload)",
                  "        }",
                  "    };",
                  "",
                  "    pm.sendRequest(req, function (err, res) {",
                  "        pm.test(`Negative Scenario: ${scenario.name}`, function () {",
                  "            if (err) throw err;",
                  "",
                  "            pm.expect(res.code, \"HTTP Status harus 400\").to.eql(400);",
                  "",
                  "            const responseJson = res.json();",
                  "            pm.expect(responseJson, \"Response tidak memiliki properti 'error'\").to.have.property('error');",
                  "            pm.expect(responseJson.error, \"Pesan error tidak sesuai\").to.eql(\"invalid request body\");",
                  "        });",
                  "    });",
                  "});",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "disabled": false
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"description\": \"Invalid payload without required name\",\n    \"price\": \"10000\"\n}",
